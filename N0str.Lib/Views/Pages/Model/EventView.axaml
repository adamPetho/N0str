<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:N0str.ViewModels.Pages.Model"
             xmlns:views="clr-namespace:N0str.Views.Pages.Model"
             xmlns:model="clr-namespace:N0str.ViewModels.Pages.Model.ContentSegments"
             xmlns:behaviors="clr-namespace:N0str.Views.Behaviors"
             x:DataType="vm:EventViewModel"
             x:Class="N0str.Views.Pages.Model.EventView">

    <UserControl.Styles>
      <Style Selector="HyperlinkButton">
          
    </Style>
    </UserControl.Styles>   

    <!-- Content Segments - Individual Segments -->
    <UserControl.DataTemplates>
       <DataTemplate DataType="model:TextSegment">
           <TextBlock Text="{Binding Text}" FontSize="14"/>
       </DataTemplate>
       <DataTemplate DataType="model:MentionSegment">
           <HyperlinkButton NavigateUri="{Binding NProfile}"
                 Content="{Binding DisplayName}" />
       </DataTemplate>
       <DataTemplate DataType="model:LinkSegment">
           <HyperlinkButton NavigateUri="{Binding Url}"
                 Content="{Binding Url}" />
       </DataTemplate>
     </UserControl.DataTemplates>

     <UserControl.Styles>
        <!-- Event card hover -->
        <Style Selector="Border.event-card:pointerover">
          <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
     </UserControl.Styles>

            <Border Classes="event-card"
                    Background="#1C1C1C"
                    BorderBrush="#252525"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,10">
              <StackPanel Spacing="12">

                <!-- Meta row: kind + timestamp -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0"
                          Background="#252525"
                          BorderBrush="#2E2E2E"
                          BorderThickness="1"
                          CornerRadius="20"
                          Padding="10,3">
                    <TextBlock Text="{Binding NostrEvent.Kind, StringFormat='kind:\{0\}'}"
                               FontSize="10"
                               Foreground="#7B68EE"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding NostrEvent.CreatedAt, StringFormat='\{0:yyyy-MM-dd · HH:mm\}'}"
                             FontSize="11"
                             Foreground="#444444"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Content -->
                <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   behaviors:ContentInlines.Segments="{Binding Content}"/>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Replying to:"
                        FontSize="11"
                        Foreground="#666666"
                        IsVisible="{Binding HasReferences}" />
                  <!-- Reply and Root -->
                  <ContentControl Content="{Binding ReferenceViewModel}" IsVisible="{Binding HasReferences}" />
                 </StackPanel>

               <!-- Tags -->
                <StackPanel Spacing="0">
                    <ItemsControl ItemsSource="{Binding NostrEvent.Tags}"
                                  IsVisible="{Binding NostrEvent.Tags.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A2E"
                                        BorderBrush="#2A2A4A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,3"
                                        Margin="0,0,6,6">
                                    <TextBlock FontSize="11" Foreground="#7B68EEaa">
                                        <Run Text="#" Foreground="#555555"/>
                                        <Run Text="{Binding TagIdentifier}"/>
                                        <Run Text=" · " Foreground="#333333"/>
                                        <Run Text="{Binding Data[0], FallbackValue=''}" Foreground="#7B68EE88"/>
                                        <Run Text=" · " Foreground="#333333"/>
                                        <Run Text="{Binding Data[2], FallbackValue=''}" Foreground="#7B68EE88"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
             </StackPanel>
     </Border>
</UserControl>
